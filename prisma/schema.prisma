// Prisma schema for NG Hip Hop Platform
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  role          String   @default("USER") // USER | ADMIN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Slogan {
  id        Int      @id @default(1)
  text      String
  updatedAt DateTime @updatedAt
}

model Song {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  file_url           String
  cover_url          String
  distribution_links Json?    // { spotify, apple, distro, publisher }
  publisher_link     String?
  is_active          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([is_active])
}

model QuoteSubmission {
  id            String    @id @default(cuid())
  quote_text    String
  submitted_by  String
  approved      Boolean   @default(false)
  is_featured   Boolean   @default(false)
  display_until DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([approved, is_featured])
  @@index([display_until])
}

model GraffitiSubmission {
  id            String    @id @default(cuid())
  image_url     String
  artist_name   String
  approved      Boolean   @default(false)
  display_until DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([approved])
  @@index([display_until])
}

model LyricGame {
  id             String   @id @default(cuid())
  lyric_text     String
  correct_artist String
  is_active      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([is_active])
}
