// Prisma schema for NG Hip Hop Platform
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  role          String   @default("USER") // USER | ADMIN
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Slogan {
  id        Int      @id @default(1)
  text      String
  updatedAt DateTime @updatedAt
}

model Song {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  file_url           String
  file_key           String?
  cover_url          String
  cover_key          String?
  distribution_links String?    // { spotify, apple, distro, publisher } JSON stringified
  publisher_link     String?
  is_active          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([is_active])
  @@index([createdAt])
}

model QuoteSubmission {
  id            String    @id @default(cuid())
  quote_text    String
  submitted_by  String
  approved      Boolean   @default(false)
  is_featured   Boolean   @default(false)
  display_until DateTime?
  scan_clean    Boolean   @default(true)
  scan_result   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([approved, is_featured, display_until])
  @@index([display_until])
  @@index([createdAt])
}

model GraffitiSubmission {
  id            String    @id @default(cuid())
  image_url     String
  image_key     String?
  artist_name   String
  approved      Boolean   @default(false)
  display_until DateTime?
  scan_clean    Boolean   @default(true)
  scan_result   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([approved, display_until])
  @@index([display_until])
  @@index([createdAt])
}

model LyricGame {
  id             String   @id @default(cuid())
  lyric_text     String
  correct_artist String
  is_active      Boolean  @default(false)
  competitionId  String?
  competition    LyricCompetition? @relation(fields: [competitionId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([is_active])
  @@index([createdAt])
  @@index([competitionId])
}

model LyricCompetition {
  id          String   @id @default(cuid())
  title       String
  period      String   // "monthly" | "yearly"
  startDate   DateTime
  endDate     DateTime
  is_active   Boolean  @default(false)
  winnerId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lyrics      LyricGame[]
  subscribers CompetitionSubscriber[]

  @@index([is_active])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model CompetitionSubscriber {
  id             String   @id @default(cuid())
  competitionId  String
  competition    LyricCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  email          String
  subscribedAt   DateTime @default(now())

  @@unique([competitionId, email])
  @@index([competitionId])
  @@index([subscribedAt])
}

model Job {
  id        String   @id @default(cuid())
  type      String
  payload   String   // JSON
  attempts  Int      @default(0)
  maxAttempts Int    @default(3)
  status    String   @default("pending") // pending | processing | completed | failed | deadLetter
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nextRetryAt DateTime?

  @@index([status, createdAt])
  @@index([nextRetryAt])
}
