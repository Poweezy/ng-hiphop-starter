// Prisma schema for NG Hip Hop Platform
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  role          String   @default("USER") // USER | ADMIN
  tokenVersion  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Slogan {
  id        Int      @id @default(1)
  text      String
  updatedAt DateTime @updatedAt
}

model Song {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  file_url           String
  file_key           String?
  cover_url          String
  cover_key          String?
  distribution_links String?    // { spotify, apple, distro, publisher } JSON stringified
  publisher_link     String?
  is_active          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([is_active])
  @@index([createdAt])
}

model QuoteSubmission {
  id            String    @id @default(cuid())
  quote_text    String
  submitted_by  String
  approved      Boolean   @default(false)
  is_featured   Boolean   @default(false)
  display_until DateTime?
  scan_clean    Boolean   @default(true)
  scan_result   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([approved, is_featured, display_until])
  @@index([display_until])
  @@index([createdAt])
}

model GraffitiSubmission {
  id            String    @id @default(cuid())
  image_url     String
  image_key     String?
  artist_name   String
  approved      Boolean   @default(false)
  display_until DateTime?
  scan_clean    Boolean   @default(true)
  scan_result   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime @updatedAt

  @@index([approved, display_until])
  @@index([display_until])
  @@index([createdAt])
}

model LyricCompetition {
  id                 String   @id @default(cuid())
  title              String
  description        String?
  type               String   @default("monthly") // monthly | yearly | custom
  status             String   @default("draft") // draft | published | archived
  slug               String?  @unique
  startDate          DateTime
  endDate            DateTime
  submissionDeadline DateTime
  bannerUrl          String?
  shortDescription   String?
  socialSharingText  String?
  viewCount          Int      @default(0)
  is_active          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rules              CompetitionRule?
  prizes             CompetitionPrize[]
  submissions        LyricSubmission[]
  participants       CompetitionParticipant[]
  subscribers        Subscriber[]
  analytics          CompetitionAnalytics?
  winners            Winner[]

  @@index([status, is_active])
  @@index([slug])
  @@index([startDate, endDate])
  @@index([createdAt])
}

model CompetitionRule {
  id                     String   @id @default(cuid())
  competitionId          String   @unique
  minLength              Int?
  maxLength              Int?
  originalityRequired    Boolean  @default(true)
  copyrightRequirements  String?
  maxSubmissionsPerUser  Int      @default(1)
  eligibilityRequirements String?
  ageRestriction         String?
  moderationRequired     Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  competition            LyricCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

model CompetitionPrize {
  id           String   @id @default(cuid())
  competitionId String
  position     Int      // 1, 2, 3...
  name         String
  cashAmount   Decimal? @db.Decimal(10, 2)
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  competition  LyricCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  winners      Winner[]

  @@unique([competitionId, position])
  @@index([competitionId])
}

model LyricSubmission {
  id                String   @id @default(cuid())
  competitionId     String
  artistAlias       String
  userId            String?
  lyrics            String
  songTitle         String?
  audioUrl          String?
  socialLinks       String?  // JSON stringified
  status            String   @default("pending") // pending | approved | rejected | disqualified | winner
  moderationStatus  String   @default("pending") // pending | approved | rejected | changes_requested
  moderationNotes   String?
  moderationReason  String?  // copyright | offensive | spam | duplicate | rules | other
  score             Int?
  ipAddress         String?
  userAgent         String?
  copyrightAccepted Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  competition       LyricCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  moderationHistory SubmissionModeration[]
  winners           Winner[]

  @@index([competitionId, status])
  @@index([competitionId, createdAt])
  @@index([userId])
}

model SubmissionModeration {
  id           String   @id @default(cuid())
  submissionId String
  action       String   // approve | reject | request_changes | disqualify
  reason       String?
  notes        String?
  moderatedBy  String?  // admin user id
  createdAt    DateTime @default(now())

  submission   LyricSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model CompetitionParticipant {
  id              String   @id @default(cuid())
  competitionId   String
  userId          String
  submissionCount Int      @default(0)
  joinedAt        DateTime @default(now())

  competition    LyricCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, userId])
}

model Subscriber {
  id                 String   @id @default(cuid())
  email              String
  name               String?
  competitionId      String
  source             String
  consentStatus      String   @default("granted") // granted | withdrawn
  consentTimestamp   DateTime @default(now())
  subscriptionStatus String   @default("active") // active | unsubscribed | bounced
  unsubscribedAt     DateTime?
  lastEmailSentAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  competition        LyricCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)

  @@unique([competitionId, email])
  @@index([email])
  @@index([subscriptionStatus])
  @@index([source])
}

model Winner {
  id           String   @id @default(cuid())
  competitionId String
  prizeId      String?
  submissionId String   @unique
  position     Int      // 1, 2, 3...
  prizeName    String?
  cashAmount   Decimal? @db.Decimal(10, 2)
  winningDate  DateTime @default(now())
  selectedBy   String?  // admin user id
  announcementStatus String @default("pending") // pending | announced | published
  createdAt    DateTime @default(now())

  competition  LyricCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  prize        CompetitionPrize? @relation(fields: [prizeId], references: [id])
  submission    LyricSubmission @relation(fields: [submissionId], references: [id])

  @@unique([competitionId, position])
  @@index([competitionId])
  @@index([submissionId])
}

model CompetitionAnalytics {
  id                 String   @id @default(cuid())
  competitionId      String   @unique
  views              Int      @default(0)
  totalSubmissions   Int      @default(0)
  uniqueParticipants Int      @default(0)
  approvedSubmissions Int     @default(0)
  rejectedSubmissions Int     @default(0)
  subscribersGenerated Int    @default(0)
  conversionRate     Decimal? @db.Decimal(5, 2)
  winners            Int      @default(0)
  prizeValue         Decimal? @db.Decimal(10, 2)
  updatedAt          DateTime @updatedAt

  competition        LyricCompetition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
}

model EmailCampaign {
  id               String   @id @default(cuid())
  name             String
  subject          String
  body             String
  recipientFilter  String?  // JSON stringified filter criteria
  recipientIds     String?  // JSON stringified subscriber IDs
  sentAt           DateTime?
  scheduledAt      DateTime?
  status           String   @default("draft") // draft | scheduled | sending | sent | failed
  createdBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Job {
  id        String   @id @default(cuid())
  type      String
  payload   String   // JSON
  attempts  Int      @default(0)
  maxAttempts Int    @default(3)
  status    String   @default("pending") // pending | processing | completed | failed | deadLetter
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nextRetryAt DateTime?

  @@index([status, createdAt])
  @@index([nextRetryAt])
}
