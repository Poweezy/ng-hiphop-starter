// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password_hash String
  role          String   @default("USER") // e.g., USER, ADMIN
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Slogan {
  id        Int      @id @default(1)
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Song {
  id                 String   @id @default(cuid())
  title              String
  file_url           String
  cover_url          String
  distribution_links Json? // Store links like { "spotify": "...", "apple": "..." }
  publisher_link     String?
  is_active          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model QuoteSubmission {
  id           String    @id @default(cuid())
  quote_text   String
  submitted_by String
  approved     Boolean   @default(false)
  display_until DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model GraffitiSubmission {
  id          String    @id @default(cuid())
  image_url   String
  artist_name String
  approved    Boolean   @default(false)
  display_until DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model LyricGame {
  id             String   @id @default(cuid())
  lyric_text     String
  correct_artist String
  is_active      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}