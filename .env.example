# NG Hip Hop Platform - Environment Variables Template

# Database (PostgreSQL via Vercel Postgres)
# On Vercel, DATABASE_URL is automatically injected when you add a Postgres database.
# For local dev, use a PostgreSQL connection string or Neon/Supabase.
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/ng_hiphop?sslmode=require"

# Next Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret_any_random_string"

# Admin Access
ADMIN_EMAIL="admin@ng.com"
ADMIN_PASSWORD="admin_password"

# Security (Password Reset)
# Set a strong secret key here. 
# You will need this key to reset your password if you forget it.
ADMIN_RESET_SECRET="your_strong_master_reset_key"

# Rate Limiting (Upstash Redis)
# Required in production. Without these, rate limiting FAILS CLOSED (requests
# denied) in production and allows in local dev.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# S3 / Object Storage (Optional for local dev)
# If set, uploads go to S3. Otherwise, files are stored in /public/uploads.
S3_BUCKET=""
S3_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
S3_SIGNED_URL_TTL_SECONDS="3600"

# Supabase Storage (alternative to S3)
# If SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are set, uploads go to Supabase Storage.
# Requires a public bucket or SUPABASE_STORAGE_PUBLIC_URL for durable public URLs.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_STORAGE_BUCKET="uploads"
SUPABASE_STORAGE_PUBLIC_URL=""

# Virus Scanning (Optional but recommended in production)
# Set VIRUS_SCANNER_ENABLED=true to enable scanning.
# When disabled, uploads FAIL CLOSED in production (rejected) and are allowed
# in local dev. To allow unverified uploads in dev, set VIRUS_SCANNER_FAIL_OPEN=true.
VIRUS_SCANNER_ENABLED="false"
VIRUS_SCANNER_FAIL_OPEN="false"
# Scanners:
# - clamav: requires CLAMAV_HOST / CLAMAV_PORT
# - webhook: requires SCAN_WEBHOOK_URL
VIRUS_SCANNER="clamav"
CLAMAV_HOST="127.0.0.1"
CLAMAV_PORT="3310"
SCAN_WEBHOOK_URL=""

# Moderation notifications
# Sent as POST { text } to this URL when a submission needs review.
# If unset, notifications fall back to server logs.
MODERATION_WEBHOOK_URL=""

# Sentry Error Tracking
SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
NEXT_PUBLIC_SENTRY_DSN=""
