# NG Hip Hop Platform - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Database URL
# For development: Use SQLite (file:./dev.db)
# For production: Use PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Free options: https://neon.tech or https://supabase.com
DATABASE_URL="file:./dev.db"

# NextAuth Configuration
# Generate a secure secret: openssl rand -base64 32
# CRITICAL: Use a strong, unique secret in production
NEXTAUTH_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION"
NEXTAUTH_URL="http://localhost:3000"

# Admin Seed Credentials (used by prisma/seed.ts)
# Change these before running seed in production
ADMIN_EMAIL="admin@ng.com"
ADMIN_PASSWORD="admin"

# Upload Configuration
# UPLOAD_DIR="uploads"
