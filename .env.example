# NG Hip Hop Platform - Environment Variables
# Copy this file to .env.local and fill in your values

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Free options: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://username:password@localhost:5432/ng_hiphop"

# NextAuth Configuration
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Admin Seed Credentials (used by prisma/seed.ts)
ADMIN_EMAIL="admin@ng.com"
ADMIN_PASSWORD="admin123"

# Upload directory (relative to /public)
# UPLOAD_DIR="uploads"
